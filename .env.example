# Local development values. Change the password before sharing an environment.
# Compose builds DATABASE_URL from POSTGRES_* values. Use URL-safe characters
# (A-Z, a-z, 0-9, underscore and hyphen) in these three values.
POSTGRES_DB=todo
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo_local_password

# Ports published on 127.0.0.1 by Docker Compose.
APP_PORT=8000
POSTGRES_PORT=5432

# Used by Deno running directly on the host, not by the Compose backend.
# Keep this URL in sync if POSTGRES_* or POSTGRES_PORT changes.
DATABASE_URL=postgresql://todo:todo_local_password@127.0.0.1:5432/todo
HOST=127.0.0.1
PORT=8000

# Integration tests use a separate database; create it before uncommenting.
# TEST_DATABASE_URL=postgresql://todo:todo_local_password@127.0.0.1:5432/todo_test
