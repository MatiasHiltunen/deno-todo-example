{
  "nodeModulesDir": "auto",
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "imports": {
    "@types/node": "npm:@types/node@24.2.0",
    "drizzle-kit": "npm:drizzle-kit@0.31.11",
    "drizzle-orm": "npm:drizzle-orm@0.45.4",
    "hono": "npm:hono@4.13.19",
    "postgres": "npm:postgres@4.1.1"
  },
  "tasks": {
    "start": "deno run --env-file=.env --allow-env --allow-net --allow-read=./public src/main.ts",
    "dev": "deno run --env-file=.env --watch=src,public --allow-env --allow-net --allow-read=./public src/main.ts",
    "db:generate": "deno run -A npm:drizzle-kit@0.31.11 generate",
    "db:migrate": "deno run --env-file=.env --allow-env --allow-net --allow-read=./drizzle src/db/migrate.ts",
    "check": "deno check src/main.ts src/db/migrate.ts drizzle.config.ts docker/healthcheck.ts tests/unit/*.ts tests/integration/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "test": "deno test --allow-env --allow-read=./public tests/unit/",
    "test:integration": "deno test --env-file=.env --allow-env --allow-net --allow-read=./drizzle,./public tests/integration/",
    "verify": "deno task fmt:check && deno task lint && deno task check && deno task test"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "exclude": ["deno.lock", "drizzle/meta"]
  },
  "exclude": ["node_modules", "coverage"]
}
